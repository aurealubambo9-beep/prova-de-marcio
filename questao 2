public static int buscaBinariaCliente(Conta[] v, int tam, String x) {
        int ini = 0;
        int fim = tam - 1;

        while (ini <= fim) {
            int meio = (ini + fim) / 2;
            int cmp = x.compareToIgnoreCase(v[meio].cliente);

            if (cmp == 0) {
                return meio;
            } else if (cmp < 0) {
                fim = meio - 1;
            } else {
                ini = meio + 1;
            }
        }
        return -1;
    }
