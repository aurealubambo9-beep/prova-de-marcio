public static int insertionSortCliente(Conta[] v, int tam) {
        int comparacoes = 0;

        for (int i = 1; i < tam; i++) {
            Conta chave = v[i];
            int j = i - 1;

            while (j >= 0) {
                comparacoes++;
                if (v[j].cliente.compareToIgnoreCase(chave.cliente) > 0) {
                    v[j + 1] = v[j];
                    j--;
                } else {
                    break;
                }
            }
            v[j + 1] = chave;
        }
        return comparacoes;
    }
